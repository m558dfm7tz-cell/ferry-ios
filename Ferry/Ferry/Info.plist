<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Ferry 使用相机拍摄照片和视频发送到你的电脑，以及扫描电脑上的连接二维码。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ferry 连接到你在本地网络上的自建 Ferry 服务器来收发消息。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ferry 在录制视频时使用麦克风。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Ferry 将你收到的照片和视频保存到相册。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ferry 读取你的照片和视频，以便选择并发送到你的电脑。</string>
	<!-- Allow the system's Open In / Copy to Ferry document handoff.
         This requires no App Group entitlement or Share Extension. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key><string>Ferry 文件</string>
			<key>CFBundleTypeRole</key><string>Viewer</string>
			<key>LSHandlerRank</key><string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
				<string>public.image</string>
				<string>public.movie</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
